# Copy to .env and adjust. Never commit .env.

# 1 for local development, 0 in production.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS, e.g. https://buss.buas.nl
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty for SQLite (local). docker-compose sets this to its PostgreSQL service.
# DATABASE_URL=postgres://buss:password@localhost:5432/buss
POSTGRES_PASSWORD=buss-dev-password

# Public address of the app, used for links and the logo in emails.
SITE_URL=http://localhost:8000

# Email sender: console (prints emails to the log), smtp or graph.
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=BUSS Startup Support <startupsupport@buas.nl>
EMAIL_REPLY_TO=startupsupport@buas.nl

# SMTP (EMAIL_PROVIDER=smtp). For the local Mailpit inbox: host=mailpit (in Docker) or localhost, port=1025, TLS off.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Microsoft Graph (EMAIL_PROVIDER=graph): app registration with the Mail.Send application permission.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=startupsupport@buas.nl
